PORT=3000
PUBLIC_BASE_URL=https://drop.example.com
X402_NETWORK=base-sepolia            # base-sepolia | base
X402_FACILITATOR_URL=https://facilitator.payai.network   # supports both networks, no account needed
PAYOUT_ADDRESS=0x...                 # required; server refuses to start without a valid address
PRICE_USD=0.25                       # charged in USDC (6 decimals)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                 # defaults to a stock ElevenLabs voice if unset
MAX_CONCURRENT_RENDERS=1
BACKGROUND_REMOVAL_ENABLED=false     # off by default -- ONNX model adds real memory/CPU per request
DATA_DIR=./data
LOG_LEVEL=info                       # debug adds request headers + bodies; silent for tests
TEST_PAYER_PRIVATE_KEY=              # local testing only, Base Sepolia
